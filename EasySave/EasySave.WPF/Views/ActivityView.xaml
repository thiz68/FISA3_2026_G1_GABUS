<UserControl x:Class="EasySave.WPF.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="920"
             Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Page header ─────────────────────────────── -->
        <Grid Grid.Row="0" Margin="32,28,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding ActivityTitle}"
                       Style="{StaticResource TitleStyle}"/>

            <Button Grid.Column="1"
                    Content="{Binding OpenLogsFolderText}"
                    Style="{StaticResource TopBarButtonStyle}"
                    Command="{Binding OpenLogsFolderCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- ── Log entries card ───────────────────────── -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="32,16,32,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Card sub-header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding RecentActivityText}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Separator -->
                <Rectangle Grid.Row="0"
                           Height="1"
                           Fill="{DynamicResource SeparatorBrush}"
                           VerticalAlignment="Bottom"/>

                <!-- List area -->
                <Grid Grid.Row="1">

                    <!-- Empty state -->
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Log entries -->
                    <ListBox x:Name="LogList"
                             ItemsSource="{Binding LogEntries}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,8,0,0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding"          Value="0,4"/>
                                <Setter Property="Background"       Value="Transparent"/>
                                <Setter Property="BorderThickness"  Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Timestamp -->
                                        <ColumnDefinition Width="68"/>
                                        <!-- Level badge -->
                                        <ColumnDefinition Width="56"/>
                                        <!-- Message -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp}"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Level badge -->
                                    <Border Grid.Column="1"
                                            Background="{Binding LevelBackground}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="4,0,8,0">
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding LevelColor}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Message -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
