<Window x:Class="EasySave.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySave.WPF"
        xmlns:vm="clr-namespace:EasySave.WPF.ViewModels"
        xmlns:views="clr-namespace:EasySave.WPF.Views"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Height="720"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- ViewModel → View mapping (DataTemplates) -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobsViewModel}">
            <views:JobsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <views:ActivityView/>
        </DataTemplate>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════
         ROOT LAYOUT: Sidebar | Content
         ══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="240"/>
            <!-- Thin separator line -->
            <ColumnDefinition Width="1"/>
            <!-- Main content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── SIDEBAR ─────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}">
            <DockPanel LastChildFill="True">

                <!-- App branding at top -->
                <Border DockPanel.Dock="Top"
                        Padding="20,24,20,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App icon using Segoe MDL2 Assets -->
                        <TextBlock Text="&#xE753;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding AppTitle}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Separator -->
                <Rectangle DockPanel.Dock="Top"
                           Height="1"
                           Fill="{DynamicResource SeparatorBrush}"
                           Margin="16,0,16,8"/>

                <!-- Exit button pinned at bottom -->
                <Border DockPanel.Dock="Bottom"
                        Padding="8,12">
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding ExitCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <TextBlock Text="&#xE7E8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ExitText}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Bottom separator -->
                <Rectangle DockPanel.Dock="Bottom"
                           Height="1"
                           Fill="{DynamicResource SeparatorBrush}"
                           Margin="16,0,16,4"/>

                <!-- Navigation items -->
                <StackPanel Margin="8,4">

                    <!-- Dashboard -->
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding NavigateToDashboardCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <TextBlock Text="&#xE80F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding DashboardText}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Backup Jobs -->
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding NavigateToJobsCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <TextBlock Text="&#xE8A1;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding BackupJobsText}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding NavigateToSettingsCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SettingsText}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Activity -->
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding NavigateToActivityCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <TextBlock Text="&#xE9D9;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ActivityText}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ── SIDEBAR / CONTENT DIVIDER ───────────────── -->
        <Rectangle Grid.Column="1"
                   Fill="{DynamicResource SeparatorBrush}"/>

        <!-- ── CONTENT AREA ────────────────────────────── -->
        <ContentControl Grid.Column="2"
                        Content="{Binding CurrentViewModel}"
                        Background="{DynamicResource BackgroundBrush}"/>

    </Grid>
</Window>
