<UserControl x:Class="EasySave.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EasySave.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="920"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- ── Page header ─────────────────────────────── -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding DashboardTitle}"
                           Style="{StaticResource TitleStyle}"/>

                <!-- Server unreachable badge -->
                <Border Grid.Column="1"
                        Style="{StaticResource ServerStatusBadgeStyle}"
                        Visibility="{Binding IsServerUnreachable,
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB90;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="#CC0000"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ServerStatus}"
                                   Foreground="#CC0000"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── State File Card ────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>

                    <!-- Card header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StateFileTitle}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Separator -->
                    <Rectangle Height="1"
                               Fill="{DynamicResource SeparatorBrush}"
                               Margin="0,0,0,16"/>

                    <!-- State file content -->
                    <TextBox Height="180"
                             TextWrapping="Wrap"
                             Style="{StaticResource MultilineTextBoxStyle}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Text="{Binding StateContent, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Background="{DynamicResource SecondarySurfaceBrush}"
                             Padding="12"/>
                </StackPanel>
            </Border>

            <!-- ── Log File Card ──────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>

                    <!-- Card header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LogFileTitle}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Separator -->
                    <Rectangle Height="1"
                               Fill="{DynamicResource SeparatorBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Log file content -->
                    <TextBox Height="180"
                             TextWrapping="Wrap"
                             Style="{StaticResource MultilineTextBoxStyle}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Text="{Binding LogContent, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Background="{DynamicResource SecondarySurfaceBrush}"
                             Padding="12"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
