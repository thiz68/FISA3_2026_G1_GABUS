<UserControl x:Class="EasySave.WPF.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EasySave.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="920"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Page title row -->
            <RowDefinition Height="Auto"/>
            <!-- Action toolbar row -->
            <RowDefinition Height="*"/>
            <!-- DataGrid card -->
        </Grid.RowDefinitions>

        <!-- ── Page title (from MainViewModel via RelativeSource) ── -->
        <TextBlock Grid.Row="0"
                   Text="{Binding DataContext.BackupJobsText,
                          RelativeSource={RelativeSource AncestorType=Window}}"
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,20"/>

        <!-- ── Toolbar: action buttons ───────────────────── -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">

            <Button Content="{Binding AddJobText}"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding AddJobCommand}"/>

            <Button Content="{Binding ExecuteAllText}"
                    MinWidth="130"
                    Margin="0,0,8,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding ExecuteAllCommand}"/>

            <Button Content="{Binding ExecuteSelectedText}"
                    MinWidth="150"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding ExecuteSelectedCommand}"/>

        </StackPanel>

        <!-- ── DataGrid Card ──────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2"
                                  Direction="270" Color="#28000000"
                                  Opacity="1"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Jobs}"
                      SelectedItem="{Binding SelectedJob}"
                      IsReadOnly="True"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <!-- Selection checkbox -->
                    <DataGridTemplateColumn Width="48" MinWidth="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name -->
                    <DataGridTextColumn
                        Header="{Binding DataContext.NameHeader,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Binding="{Binding Name}"
                        Width="*"/>

                    <!-- Source -->
                    <DataGridTextColumn
                        Header="{Binding DataContext.SourceHeader,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Binding="{Binding SourcePath}"
                        Width="2*"/>

                    <!-- Target -->
                    <DataGridTextColumn
                        Header="{Binding DataContext.TargetHeader,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Binding="{Binding TargetPath}"
                        Width="2*"/>

                    <!-- Type -->
                    <DataGridTextColumn
                        Header="{Binding DataContext.TypeHeader,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Binding="{Binding TypeDisplay}"
                        Width="*"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn
                        Header="{Binding DataContext.ActionsHeader,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Button Content="{Binding DataContext.EditText,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            MinWidth="64"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource TopBarButtonStyle}"
                                            Command="{Binding DataContext.EditJobCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{Binding DataContext.DeleteText,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            MinWidth="72"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.DeleteJobCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Add / Edit Dialog Overlay ─────────────────── -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsDialogOpen,
                           Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- Frosted/dim overlay -->
            <Border Background="{DynamicResource OverlayBrush}"/>

            <!-- Dialog sheet -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="32,28"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8"
                                      Direction="270" Color="#40000000"
                                      Opacity="1"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Dialog title (reuse AddJobText) -->
                    <TextBlock Text="{Binding AddJobText}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,24"/>

                    <!-- ── Job Name ── -->
                    <TextBlock Text="{Binding NameHeader}"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding DialogJobName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- ── Source Path ── -->
                    <TextBlock Text="{Binding SourceHeader}"
                               Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding DialogSourcePath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2"
                                Content="Browse…"
                                MinWidth="80"
                                Style="{StaticResource TopBarButtonStyle}"
                                Click="BrowseSource_Click"/>
                    </Grid>

                    <!-- ── Target Path ── -->
                    <TextBlock Text="{Binding TargetHeader}"
                               Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding DialogTargetPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2"
                                Content="Browse…"
                                MinWidth="80"
                                Style="{StaticResource TopBarButtonStyle}"
                                Click="BrowseTarget_Click"/>
                    </Grid>

                    <!-- ── Backup Type ── -->
                    <TextBlock Text="{Binding TypeHeader}"
                               Style="{StaticResource LabelStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <RadioButton Content="Full"
                                     IsChecked="{Binding DialogType,
                                                 Converter={StaticResource BackupTypeConverter},
                                                 ConverterParameter=full}"
                                     Margin="0,0,24,0"/>
                        <RadioButton Content="Differential"
                                     IsChecked="{Binding DialogType,
                                                 Converter={StaticResource BackupTypeConverter},
                                                 ConverterParameter=diff}"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Height="1"
                               Fill="{DynamicResource SeparatorBrush}"
                               Margin="0,0,0,20"/>

                    <!-- ── Dialog buttons ── -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                MinWidth="88"
                                Margin="0,0,10,0"
                                Style="{StaticResource TopBarButtonStyle}"
                                Command="{Binding CancelDialogCommand}"/>
                        <Button Content="Save"
                                MinWidth="88"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding SaveJobCommand}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
