<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════╗
    ║   EASYSAVE — LIGHT THEME                 ║
    ║   macOS-inspired light palette           ║
    ╚══════════════════════════════════════════╝
    -->

    <!-- ── Background hierarchy ─────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush"           Color="#F2F2F7"/>
    <SolidColorBrush x:Key="SurfaceBrush"              Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondarySurfaceBrush"     Color="#F5F5F7"/>
    <SolidColorBrush x:Key="SidebarBrush"              Color="#EBEBED"/>
    <SolidColorBrush x:Key="TopBarBrush"               Color="#FAFAFA"/>

    <!-- ── Accent & interactive ──────────────────────────────── -->
    <SolidColorBrush x:Key="AccentBrush"               Color="#007AFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"          Color="#0066D6"/>
    <SolidColorBrush x:Key="AccentPressedBrush"        Color="#004FB3"/>
    <SolidColorBrush x:Key="DangerBrush"               Color="#FF3B30"/>
    <SolidColorBrush x:Key="DangerHoverBrush"          Color="#D63027"/>
    <SolidColorBrush x:Key="PauseBrush"                Color="#FF9500"/>
    <SolidColorBrush x:Key="PauseHoverBrush"           Color="#D97C00"/>
    <SolidColorBrush x:Key="SecondaryButtonBrush"      Color="#E5E5EA"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#D1D1D6"/>
    <SolidColorBrush x:Key="SuccessBrush"              Color="#34C759"/>

    <!-- ── Text ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryTextBrush"          Color="#1D1D1F"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"        Color="#6E6E73"/>
    <SolidColorBrush x:Key="TertiaryTextBrush"         Color="#AEAEB2"/>
    <SolidColorBrush x:Key="OnAccentTextBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentTextBrush"           Color="#007AFF"/>
    <SolidColorBrush x:Key="DangerTextBrush"           Color="#FF3B30"/>

    <!-- ── Borders & separators ──────────────────────────────── -->
    <SolidColorBrush x:Key="SeparatorBrush"            Color="#E5E5EA"/>
    <SolidColorBrush x:Key="CardBorderBrush"           Color="#E5E5EA"/>
    <SolidColorBrush x:Key="InputBorderBrush"          Color="#C7C7CC"/>
    <SolidColorBrush x:Key="InputBorderFocusBrush"     Color="#007AFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"      Color="#FFFFFF"/>

    <!-- ── DataGrid ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="DataGridHeaderBrush"       Color="#F5F5F7"/>
    <SolidColorBrush x:Key="DataGridHeaderTextBrush"   Color="#6E6E73"/>
    <SolidColorBrush x:Key="RowHoverBrush"             Color="#EEF4FF"/>
    <SolidColorBrush x:Key="RowAlternatingBrush"       Color="#FAFAFA"/>
    <SolidColorBrush x:Key="RowSelectedBrush"          Color="#D6EAFF"/>
    <SolidColorBrush x:Key="RowSelectedTextBrush"      Color="#1D1D1F"/>

    <!-- ── Sidebar navigation ────────────────────────────────── -->
    <SolidColorBrush x:Key="NavItemHoverBrush"         Color="#DCDCE0"/>
    <SolidColorBrush x:Key="NavItemActiveBrush"        Color="#D6EAFF"/>
    <SolidColorBrush x:Key="NavItemActiveTextBrush"    Color="#007AFF"/>

    <!-- ── Misc ───────────────────────────────────────────────── -->
    <Color x:Key="ShadowColor">#28000000</Color>
    <SolidColorBrush x:Key="OverlayBrush"              Color="#80000000"/>

</ResourceDictionary>
